# ============================================================================
#  BankSploit environment — copy this file to ".env" and adjust if needed.
#      cp .env.example .env        (macOS/Linux)
#      copy .env.example .env      (Windows cmd)
#  The defaults below work out of the box; you only need to edit them for the
#  optional "custom domain" setup described at the bottom.
# ============================================================================

# ---- Hostname, scheme and ports --------------------------------------------
# The app is served over HTTPS with a bundled self-signed certificate. Port 80
# only 301-redirects to 443. With these defaults the app is reachable at:
#     https://localhost           (accept the browser's self-signed warning)
APP_SCHEME=https
APP_HOST=localhost
APP_PORT=443
APP_HTTP_PORT=80
APP_HTTPS_PORT=443

# phpMyAdmin (plain HTTP) and the externally exposed MySQL port.
PMA_PORT=8081
DB_EXTERNAL_PORT=3307

# ---- Database (training defaults — fine to keep as-is) ----------------------
DB_NAME=banksploit
DB_USER=banksploit
DB_PASS=banksploit_pass
DB_ROOT_PASS=root_pass

# ---- App -------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
JWT_SECRET=insecure_jwt_secret_for_training

# ============================================================================
#  OPTIONAL — run it under a real-looking domain (banksploit.com)
# ----------------------------------------------------------------------------
#  The bundled TLS certificate is issued for "banksploit.com", so using this
#  hostname removes the certificate name-mismatch warning and makes the app
#  behave like a real site — which is cleaner when proxying through Burp Suite.
#
#  1. Set:
#        APP_HOST=banksploit.com
#        APP_PORT=443
#  2. Map the name to your machine by adding this line to the hosts file
#     (edit it as Administrator / root):
#        127.0.0.1   banksploit.com
#        Windows:    C:\Windows\System32\drivers\etc\hosts
#        macOS/Linux:/etc/hosts
#  3. Apply:  docker compose up -d
#  4. Browse: https://banksploit.com
# ============================================================================
